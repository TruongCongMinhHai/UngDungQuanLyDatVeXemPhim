<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinenow_background"
    android:fillViewport="true"
    tools:context=".ui.tickets.TicketDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="40dp">

        <!-- 1. Top Bar: Nút Back + Logo CineNow + Tiêu đề + Avatar nhỏ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/cinenow_text_primary" />

            <!-- Logo CineNow -->
            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Logo CineNow"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cinenow_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CineNow"
                    android:textColor="@color/cinenow_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chi tiết vé"
                    android:textColor="@color/cinenow_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgTopAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@color/cinenow_primary"
                android:padding="7dp"
                android:src="@drawable/ic_person"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:tint="@color/cinenow_white" />
        </LinearLayout>

        <!-- 2. Thẻ vé điện tử chính (Digital Ticket Card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMainTicket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/cinenow_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/cinenow_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Bar rạp chiếu & IMAX Laser -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@color/cinenow_primary"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_ticket"
                        app:tint="@color/cinenow_white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="CineNow Landmark 81"
                        android:textColor="@color/cinenow_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="IMAX LASER"
                        android:textColor="@color/cinenow_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Thông tin phim & Poster nhỏ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#FEE2E2"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="T16"
                            android:textColor="#DC2626"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="HÀNH TINH CÁT 2"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="DUNE: PART TWO • IMAX 2D"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Thumbnail poster nhỏ góc phải -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgDetailPoster"
                        android:layout_width="54dp"
                        android:layout_height="74dp"
                        android:background="@color/cinenow_surface_container_high"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_ticket"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                        app:tint="@color/cinenow_outline" />
                </LinearLayout>

                <!-- 3 Khung thông tin suất chiếu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="@color/cinenow_surface_container_low"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <!-- Cột 1: Giờ chiếu -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giờ chiếu"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="16:45"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25/10/2024"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Divider đứng -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/cinenow_outline" />

                    <!-- Cột 2: Phòng chiếu -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phòng chiếu"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="03"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tầng 5"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Divider đứng -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/cinenow_outline" />

                    <!-- Cột 3: Ghế ngồi -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ghế ngồi"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="F5, F6, F7"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Ghế VIP"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Vết cắt cuống vé -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="14dp">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="-7dp"
                        android:background="@drawable/bg_camera_circle"
                        android:backgroundTint="@color/cinenow_background" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerVertical="true"
                        android:layout_marginHorizontal="12dp"
                        android:background="@color/cinenow_outline" />

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-7dp"
                        android:background="@drawable/bg_camera_circle"
                        android:backgroundTint="@color/cinenow_background" />
                </RelativeLayout>

                <!-- Mã đặt chỗ Booking ID (Bấm để sao chép) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã đặt chỗ (Booking ID)"
                        android:textColor="@color/cinenow_text_secondary"
                        android:textSize="12sp" />

                    <!-- Khung mã vé bấm sao chép -->
                    <LinearLayout
                        android:id="@+id/btnCopyBookingCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="@color/cinenow_secondary_container"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvBookingCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#CN-88921-UIT"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_copy" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Khung soát vé: QR Code lớn & Barcode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="@color/cinenow_surface_container_lowest"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Mã QR Code lớn -->
                    <ImageView
                        android:id="@+id/imgLargeQrCode"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:src="@drawable/ic_qr_code"
                        app:tint="@color/cinenow_text_primary" />

                    <!-- Dòng lưu ý cho nhân viên soát vé -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="#16A34A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Đưa mã cho nhân viên tại cửa rạp"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Mã vạch Barcode -->
                    <ImageView
                        android:id="@+id/imgBarcode"
                        android:layout_width="220dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_barcode" />

                    <!-- Dãy số Barcode -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.25"
                        android:text="8 8 9 2 1 0 5 4 3 2 1"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Card: Chi tiết đơn hàng -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOrderDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/cinenow_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/cinenow_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header: Chi tiết đơn hàng + Badge Đã thanh toán -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_ticket"
                        app:tint="@color/cinenow_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Chi tiết đơn hàng"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#DCFCE7"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="● Đã thanh toán"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dòng 1: Người đặt -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Người đặt:"
                        android:textColor="@color/cinenow_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nguyễn Văn An"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dòng 2: Số điện thoại -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số điện thoại:"
                        android:textColor="@color/cinenow_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0901 234 567"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Dòng 3: Gói vé & Combo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gói vé &amp; Combo:"
                        android:textColor="@color/cinenow_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 vé VIP + 1 Combo bắp nước"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Divider ngang -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/cinenow_outline" />

                <!-- Dòng Tổng tiền thanh toán -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng tiền thanh toán:"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="445.000 đ"
                        android:textColor="@color/cinenow_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Card: Nhóm CineTogether -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGroupInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/cinenow_secondary_container"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Icon tròn màu tím -->
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_camera_circle"
                    android:backgroundTint="@color/cinenow_primary"
                    android:padding="8dp"
                    android:src="@drawable/ic_group"
                    app:tint="@color/cinenow_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhóm &quot;Hội Mọt Phim UIT&quot;"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="3/3 bạn đã nhận vị trí ghế"
                        android:textColor="@color/cinenow_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Icon check xác nhận -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_auth_check_circle"
                    app:tint="@color/cinenow_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Nút Lưu vé vào thư viện ảnh -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTicketImage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:text="Lưu vé vào thư viện ảnh"
            android:textColor="@color/cinenow_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cinenow_primary"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/cinenow_white"
            app:rippleColor="@color/cinenow_primary_container" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>