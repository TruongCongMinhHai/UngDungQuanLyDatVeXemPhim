<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cinenow_background"
    tools:context=".ui.tickets.TicketDetailFragment">

    <!-- Header dùng chung CineHeader: cố định 64dp, có nút back, không nút profile -->
    <com.ute.cinenow.utils.CineHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Chi tiết vé"
        app:headerShowBack="true"
        app:headerShowProfile="false" />

    <!-- Vùng nội dung cuộn bên dưới Header -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <!-- 2. Thẻ vé điện tử chính (Digital Ticket Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMainTicket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/cinenow_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header Bar rạp chiếu & IMAX Laser -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/cinenow_surface_container_low"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_ticket"
                            app:tint="@color/cinenow_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="CGV Landmark 81 - Rạp IMAX"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#F2FFFFFF"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="IMAX Laser"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Thông tin Tên phim, Phân loại, Thumbnail Poster thật -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#FEE2E2"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="T16"
                                android:textColor="#DC2626"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="HÀNH TINH CÁT 2"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="DUNE: PART TWO • IMAX 2D"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Thumbnail poster thật Hành Tinh Cát 2 -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgDetailPoster"
                            android:layout_width="54dp"
                            android:layout_height="74dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/poster_hanh_tinh_cat_2"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
                    </LinearLayout>

                    <!-- 3 Khung thông tin suất chiếu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="@color/cinenow_surface_container_low"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <!-- Cột 1: Giờ chiếu -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Giờ chiếu"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="16:45"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hôm nay"
                                android:textColor="@color/cinenow_text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/cinenow_outline" />

                        <!-- Cột 2: Ngày chiếu -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ngày chiếu"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="20/11/2026"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thứ Sáu"
                                android:textColor="@color/cinenow_text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/cinenow_outline" />

                        <!-- Cột 3: Phòng chiếu -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phòng chiếu"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="IMAX 01"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tầng 5"
                                android:textColor="@color/cinenow_text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Chi tiết số ghế & Định dạng vé -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GHẾ ĐÃ CHỌN (02 VÉ)"
                                android:textColor="@color/cinenow_text_tertiary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Ghế: F10, F11 (Standard VIP)"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Badge mã ghế nổi bật -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@color/cinenow_secondary_container"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="F10, F11"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Đường rãnh cuống vé đứt đoạn kèm 2 vết khuyết cung tròn -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Vết khuyết bán nguyệt bên trái -->
                        <View
                            android:layout_width="14dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@color/cinenow_background" />

                        <!-- Nét đứt vé -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="6dp"
                            android:layout_weight="1"
                            android:background="@color/cinenow_outline" />

                        <!-- Vết khuyết bán nguyệt bên phải -->
                        <View
                            android:layout_width="14dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@color/cinenow_background" />
                    </LinearLayout>

                    <!-- Khu vực MÃ QR & BARCODE SOÁT VÉ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MÃ ĐẶT CHỖ (BOOKING ID)"
                            android:textColor="@color/cinenow_text_tertiary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <!-- Hộp sao chép mã đặt vé -->
                        <LinearLayout
                            android:id="@+id/btnCopyBookingCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tvBookingCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CN-88921-UIT"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_copy"
                                app:tint="@color/cinenow_primary" />
                        </LinearLayout>

                        <!-- Khung Mã QR lớn chính giữa -->
                        <FrameLayout
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@color/cinenow_white"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgLargeQrCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_qr_code"
                                app:tint="@color/cinenow_text_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Đưa mã này cho nhân viên soát vé tại cửa rạp"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="12sp" />

                        <!-- Mã vạch Barcode bên dưới -->
                        <ImageView
                            android:id="@+id/imgBarcode"
                            android:layout_width="220dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_barcode"
                            app:tint="@color/cinenow_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="8 9 3 8 5 0 2 1 9 4 0 2 8"
                            android:textColor="@color/cinenow_text_tertiary"
                            android:textSize="10sp"
                            android:letterSpacing="0.2" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Card Chi tiết Đơn hàng & Thanh toán -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/cinenow_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header: Chi tiết đơn hàng + Badge Đã thanh toán -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_ticket"
                            app:tint="@color/cinenow_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Chi tiết đơn hàng"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#DCFCE7"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Đã thanh toán"
                            android:textColor="#16A34A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hàng 1: Giá vé -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Giá vé IMAX (2 x 180.000đ)"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="360.000đ"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hàng 2: Bắp nước Combo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Combo Bắp Nước CineCouple"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="119.000đ"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hàng 3: Giảm giá HSSV UIT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ưu đãi Sinh viên UIT (-20%)"
                            android:textColor="@color/cinenow_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-72.000đ"
                            android:textColor="@color/cinenow_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/cinenow_outline" />

                    <!-- Hàng 4: Tổng thanh toán -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng tiền thanh toán"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thanh toán qua Ví MoMo"
                                android:textColor="@color/cinenow_text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="407.000đ"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Card Nhóm xem chung CineTogether (#17) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGroupInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/cinenow_surface_container_low"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="@color/cinenow_secondary"
                        android:padding="8dp"
                        android:src="@drawable/ic_group"
                        app:tint="@color/cinenow_white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhóm xem cùng: UIT Movie Club"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đã chia tiền tự động qua CineTogether (#17)"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/cinenow_text_tertiary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Hộp lưu ý quy định rạp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_info_hint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_auth_check_circle"
                    app:tint="@color/cinenow_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Vui lòng có mặt trước giờ chiếu 15 phút. Xuất trình thẻ HSSV nếu nhân viên rạp yêu cầu kiểm tra."
                    android:textColor="@color/cinenow_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 6. Nút Lưu vé vào thư viện ảnh -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTicketImage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="Lưu vé vào thư viện ảnh"
                android:textColor="@color/cinenow_primary"
