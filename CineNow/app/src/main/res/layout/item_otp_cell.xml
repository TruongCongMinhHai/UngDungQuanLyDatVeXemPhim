<?xml version="1.0" encoding="utf-8"?>
<!-- Một ô số của mã OTP. Được tạo 6 lần trong VerifyAccountFragment -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="56dp"
    android:layout_marginHorizontal="4dp"
    android:layout_weight="1"
    android:background="@drawable/bg_otp_cell">

    <TextView
        android:id="@+id/tvDigit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:textColor="@color/cinenow_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/vDash"
        android:layout_width="16dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_otp_dash" />
</FrameLayout>