<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <!-- Header chung CineNow -->
    <com.ute.cinenow.utils.CineHeader
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:headerShowBack="true"
        app:headerTitle="CineConnect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <!-- Banner: Kết nối bạn xem phim -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#5850EC"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Kết nối bạn xem phim"
                            android:src="@drawable/ic_group"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Kết nối bạn xem phim"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tìm bạn cùng gu điện ảnh, kết nối và rủ nhau đi xem phim."
                        android:textColor="#E0E7FF"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lời mời kết bạn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Lời mời kết bạn"
                    android:src="@drawable/ic_home_people"
                    app:tint="#5850EC" />

                <TextView
                    android:id="@+id/tvFriendRequestsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Lời mời kết bạn"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvViewAllRequests"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textColor="#5850EC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="Xem tất cả lời mời"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#5850EC" />
            </LinearLayout>

            <!-- Bạn bè của bạn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="@android:color/white"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_camera_circle"
                        android:backgroundTint="#10B981" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Bạn bè của bạn"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvViewAllFriends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả"
                        android:textColor="#5850EC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Xem tất cả bạn bè"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#5850EC" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Bạn 1: Hoàng Nam -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_camera_circle"
                                android:backgroundTint="#E2E8F0"
                                android:contentDescription="Hoàng Nam"
                                android:padding="2dp"
                                android:src="@drawable/ic_person" />

                            <View
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_camera_circle"
                                android:backgroundTint="#10B981" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Hoàng Nam"
                            android:textColor="#0F172A"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Online"
                            android:textColor="#10B981"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Bạn 2: Vũ Mai Anh -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_camera_circle"
                                android:backgroundTint="#E2E8F0"
                                android:contentDescription="Vũ Mai Anh"
                                android:padding="2dp"
                                android:src="@drawable/ic_person" />

                            <View
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_camera_circle"
                                android:backgroundTint="#10B981" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Vũ Mai Anh"
                            android:textColor="#0F172A"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 phút trước"
                            android:textColor="#64748B"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Bạn 3: Bảo Minh -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_camera_circle"
                                android:backgroundTint="#E2E8F0"
                                android:contentDescription="Bảo Minh"
                                android:padding="2dp"
                                android:src="@drawable/ic_person" />

                            <View
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_camera_circle"
                                android:backgroundTint="#10B981" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bảo Minh"
                            android:textColor="#0F172A"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hôm qua"
                            android:textColor="#64748B"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Nút Thêm -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="#EDE9FE"
                            android:contentDescription="Thêm bạn bè"
                            android:padding="12dp"
                            android:src="@drawable/ic_cm_add_circle"
                            app:tint="#5850EC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Thêm"
                            android:textColor="#5850EC"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Khám phá bạn bè -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Khám phá bạn bè"
                        android:src="@drawable/ic_explore"
                        app:tint="#5850EC" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Khám phá bạn bè"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvViewAllExplore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả"
                        android:textColor="#5850EC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Xem tất cả khám phá"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#5850EC" />
                </LinearLayout>

                <!-- Thanh tìm kiếm & Lọc -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="@android:color/white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Tìm kiếm"
                            android:src="@drawable/ic_home_search"
                            app:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/etSearchUser"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:background="@android:color/transparent"
                            android:hint="Tìm tên người dùng..."
                            android:inputType="text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@android:color/white"
                        android:text="Bộ lọc"
                        android:textAllCaps="false"
                        android:textColor="#0F172A"
                        android:textSize="11.5sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_home_tune"
                        app:iconTint="#0F172A"
                        app:strokeColor="#CBD5E1"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Danh sách thể loại ngang -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#5850EC"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Tất cả"
                            android:textColor="@android:color/white"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@android:color/white"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Khoa học viễn tưởng"
                            android:textColor="#475569"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@android:color/white"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Hành động"
                            android:textColor="#475569"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@android:color/white"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Anime"
                            android:textColor="#475569"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@android:color/white"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="TP.HCM"
                            android:textColor="#475569"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- CARD USER 1: Nguyễn Thảo Ly -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_camera_circle"
                                    android:backgroundTint="#CBD5E1"
                                    android:contentDescription="Ảnh đại diện Nguyễn Thảo Ly"
                                    android:src="@drawable/ic_person" />

                                <View
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="bottom|end"
                                    android:background="@drawable/bg_camera_circle"
                                    android:backgroundTint="#10B981" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Nguyễn Thảo Ly"
                                        android:textColor="#0F172A"
                                        android:textSize="13.5sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="22 tuổi"
                                        android:textColor="#64748B"
                                        android:textSize="11.5sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="13dp"
                                        android:layout_height="13dp"
                                        android:contentDescription="Rạp chiếu"
                                        android:src="@drawable/ic_home_place"
                                        app:tint="#5850EC" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="CineNow Landmark 81"
                                        android:textColor="#5850EC"
                                        android:textSize="11.5sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Mê phim viễn tưởng &amp; rạp IMAX cuối tuần.\nThích thảo luận cốt truyện sau phim!"
                            android:textColor="#334155"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F1F5F9"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Khoa học viễn tưởng"
                                android:textColor="#475569"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F1F5F9"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="IMAX"
                                android:textColor="#475569"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F1F5F9"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Anime"
                                android:textColor="#475569"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#F1F5F9" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F8FAFC"
                                android:text="Xem hồ sơ"
                                android:textAllCaps="false"
                                android:textColor="#475569"
                                android:textSize="11.5sp"
                                app:cornerRadius="10dp"
                                app:strokeColor="#E2E8F0"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="#5850EC"
                                android:text="Kết bạn"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="11.5sp"
                                app:cornerRadius="10dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD USER 2: Trần Bảo Long -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_camera_circle"
