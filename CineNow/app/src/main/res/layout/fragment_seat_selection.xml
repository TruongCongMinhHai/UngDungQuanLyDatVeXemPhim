<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1A1A1A" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_rounded_icon"
            android:backgroundTint="#F3F0FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cinenow_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CineNow"
                    android:textColor="#5850EC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn ghế"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_camera_circle"
            android:backgroundTint="#5850EC"
            android:padding="6dp"
            android:src="@drawable/ic_person"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="160dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Thông tin phòng chiếu & suất chiếu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Sơ đồ phòng chiếu 03"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="16:45 • Hành Tinh Cát: Phần 2 • IMAX 2D"
                android:textColor="#64748B"
                android:textSize="11.5sp" />

            <!-- Màn hình chiếu (Screen Curve) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/white"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="220dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="#5850EC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🖥  MÀN HÌNH CHIẾU (SCREEN)"
                    android:textColor="#64748B"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <!-- Chú thích trạng thái ghế -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="12dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#E2E8F0" android:layout_marginEnd="4dp"/>
                        <TextView android:text="Ghế trống" android:textSize="10.5sp" android:textColor="#475569" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="12dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:layout_marginEnd="4dp"/>
                        <TextView android:text="Đã đặt" android:textSize="10.5sp" android:textColor="#475569" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="12dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F3F0FF" android:layout_marginEnd="4dp"/>
                        <TextView android:text="Ghế VIP" android:textSize="10.5sp" android:textColor="#475569" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#5850EC" android:layout_marginEnd="4dp"/>
                        <TextView android:text="Đang chọn" android:textSize="10.5sp" android:textColor="#475569" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Gợi ý SmartBanner Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F3F0FF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Gợi ý SmartSeat: Dãy F5 - I"
                            android:textColor="#312E81"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#E0E7FF"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="98% Tương thích"
                            android:textColor="#4338CA"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Vị trí trung tâm tối ưu tầm nhìn và hiệu ứng âm thanh vòm"
                        android:textColor="#4338CA"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SƠ ĐỒ GHẾ NGỒI (Mô phỏng lưới ghế A - H) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@android:color/white"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Dãy A -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:text="A" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                    <TextView android:id="@+id/seatA1" android:text="1" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA2" android:text="2" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA3" android:text="3" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA4" android:text="4" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA5" android:text="5" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA6" android:text="6" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA7" android:text="7" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA8" android:text="8" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA9" android:text="9" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatA10" android:text="10" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:text="A" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                </LinearLayout>

                <!-- Dãy B -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:text="B" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                    <TextView android:id="@+id/seatB1" android:text="1" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB2" android:text="2" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB3" android:text="3" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB4" android:text="4" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB5" android:text="5" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB6" android:text="6" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB7" android:text="7" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB8" android:text="8" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB9" android:text="9" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatB10" android:text="10" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:text="B" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                </LinearLayout>

                <!-- Dãy C -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:text="C" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                    <TextView android:id="@+id/seatC1" android:text="1" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC2" android:text="2" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC3" android:text="3" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC4" android:text="4" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC5" android:text="5" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC6" android:text="6" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC7" android:text="7" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC8" android:text="8" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC9" android:text="9" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatC10" android:text="10" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:text="C" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                </LinearLayout>

                <!-- Dãy D -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:text="D" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                    <TextView android:id="@+id/seatD1" android:text="1" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD2" android:text="2" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD3" android:text="3" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD4" android:text="4" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD5" android:text="5" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD6" android:text="6" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD7" android:text="7" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD8" android:text="8" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:gravity="center" android:textSize="10.5sp" android:textColor="#94A3B8" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD9" android:text="9" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:id="@+id/seatD10" android:text="10" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
                    <TextView android:text="D" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                </LinearLayout>

                <!-- Dãy E -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:text="E" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center"/>
                    <TextView android:id="@+id/seatE1" android:text="1" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:gravity="center" android:textSize="10.5sp" android:textColor="#0F172A" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginHorizontal="2px"/>
