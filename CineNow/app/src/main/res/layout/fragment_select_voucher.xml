<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <com.ute.cinenow.utils.CineHeader
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:headerShowBack="true"
        app:headerTitle="Chọn ưu đãi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="104dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="14dp"
            android:paddingBottom="18dp">

            <!-- THẺ ĐƠN ĐẶT VÉ HIỆN TẠI -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#EEF2FF"
                            android:drawableStart="@drawable/ic_booking_ticket"
                            android:drawablePadding="5dp"
                            android:drawableTint="#4F46E5"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Đơn đặt vé hiện tại"
                            android:textColor="#4338CA"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tạm tính"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hành Tinh Cát 2"
                            android:textColor="#0F172A"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="465.000 đ"
                            android:textColor="#4F46E5"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="CineNow Landmark 81"
                        android:textColor="#64748B"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="16:45 • Thứ Sáu, 25/10/2026"
                        android:textColor="#64748B"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NHẬP MÃ KHUYẾN MÃI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:drawableStart="@drawable/ic_voucher_gift"
                android:drawablePadding="6dp"
                android:drawableTint="#4F46E5"
                android:gravity="center_vertical"
                android:text="Bạn có mã ưu đãi?"
                android:textColor="#0F172A"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="5dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Mã giảm giá"
                        android:src="@drawable/ic_booking_tag"
                        app:tint="#94A3B8" />

                    <EditText
                        android:id="@+id/etPromoCode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="NHẬP MÃ KHUYẾN MÃI KHÁC"
                        android:inputType="textCapCharacters"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="11.5sp" />

                    <Button
                        android:id="@+id/btnApplyCode"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="#4F46E5"
                        android:paddingHorizontal="14dp"
                        android:text="Áp dụng"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="9dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TIÊU ĐỀ ƯU ĐÃI DÀNH CHO BẠN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ưu đãi dành cho bạn"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="#EEF2FF"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:text="3 mã khả dụng"
                    android:textColor="#4F46E5"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- VOUCHER 1: ĐANG ÁP DỤNG (CÓ VIỀN TRÁI ĐẬM NHƯ ẢNH GỐC) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVoucher1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#4338CA" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#4338CA"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="CINEMAX20K"
                                android:textColor="@android:color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#DCFCE7"
                                android:drawableStart="@drawable/ic_booking_check_outline"
                                android:drawablePadding="3dp"
                                android:drawableTint="#15803D"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:text="Đang áp dụng"
                                android:textColor="#15803D"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/btnActionVoucher1"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:backgroundTint="#F1F5F9"
                                android:minWidth="0dp"
                                android:paddingHorizontal="12dp"
                                android:text="Bỏ chọn"
                                android:textAllCaps="false"
                                android:textColor="#475569"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Giảm 20.000 đ cho đơn từ 300.000 đ"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawableStart="@drawable/ic_info"
                            android:drawablePadding="4dp"
                            android:drawableTint="#64748B"
                            android:gravity="center_vertical"
                            android:text="Áp dụng cho mọi suất chiếu • HSD: 30/11/2026"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- VOUCHER 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVoucher2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#F1F5F9"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="CINEVIP15"
                            android:textColor="#334155"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btnActionVoucher2"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:backgroundTint="#EEF2FF"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Áp dụng"
                            android:textAllCaps="false"
                            android:textColor="#4F46E5"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Giảm 15% giá vé xem phim"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_booking_clock"
                        android:drawablePadding="4dp"
                        android:drawableTint="#64748B"
                        android:gravity="center_vertical"
                        android:text="Tối đa 40.000 đ cho thành viên • HSD: 15/12/2026"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- VOUCHER 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVoucher3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#F1F5F9"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="COMBOMAX30"
                            android:textColor="#334155"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btnActionVoucher3"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:backgroundTint="#EEF2FF"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Áp dụng"
                            android:textAllCaps="false"
                            android:textColor="#4F46E5"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Giảm 30.000 đ cho Combo bắp nước"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_voucher_combo"
                        android:drawablePadding="4dp"
                        android:drawableTint="#64748B"
                        android:gravity="center_vertical"
                        android:text="Áp dụng khi mua kèm 01 Combo • HSD: 20/11/2026"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ƯU ĐÃI CHƯA ĐỦ ĐIỀU KIỆN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ưu đãi chưa đủ điều kiện (1)"
                    android:textColor="#64748B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Mở rộng"
                    android:rotation="270"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#64748B" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#E2E8F0"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="MEGA50K"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chưa đủ điều kiện"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Giảm 50.000 đ cho đơn từ 600.000 đ"
                        android:textColor="#94A3B8"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_info"
                        android:drawablePadding="4dp"
                        android:drawableTint="#EF4444"
                        android:gravity="center_vertical"
                        android:text="Đơn hàng chưa đạt giá trị tối thiểu (Cần thêm 135.000 đ)"
                        android:textColor="#DC2626"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- THANH XÁC NHẬN DƯỚI CÙNG -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiết kiệm được"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvTotalSavings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20.000 đ"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmVoucher"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:backgroundTint="#4F46E5"
                android:paddingHorizontal="20dp"
                android:text="Xác nhận ưu đãi"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_booking_check_outline"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconTint="@android:color/white" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
