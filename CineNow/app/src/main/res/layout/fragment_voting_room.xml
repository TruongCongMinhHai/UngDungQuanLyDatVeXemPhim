<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cinenow_background"
    tools:context=".ui.cinetogether.VotingRoomFragment">

    <!-- Header chuẩn CineHeader: 64dp, có nút back, không nút profile -->
    <com.ute.cinenow.utils.CineHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Phòng bình chọn phim"
        app:headerShowBack="true"
        app:headerShowProfile="false" />

    <!-- Vùng nội dung cuộn -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Card Thông tin phòng & Mã PIN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/cinenow_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Hàng tên phòng + Nút sao chép mã PIN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:padding="8dp"
                            android:src="@drawable/ic_group"
                            app:tint="@color/cinenow_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRoomName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UIT Movie Weekend"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRoomPin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Mã phòng: 889 966"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Nút sao chép mã PIN -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyPin"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Sao chép"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="12sp"
                            app:backgroundTint="@color/cinenow_primary_container"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="14dp"
                            app:iconTint="@color/cinenow_primary" />
                    </LinearLayout>

                    <!-- Divider nhẹ -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/cinenow_outline" />

                    <!-- Hàng Chips trạng thái: Rạp chiếu & Hạn chót -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_home_place"
                                app:tint="@color/cinenow_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="CGV Landmark 81"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_md_clock"
                                app:tint="@color/cinenow_primary" />

                            <TextView
                                android:id="@+id/tvCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Hạn chót: 15:42"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Hàng thành viên & Nút xem chi tiết -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMemberStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3/4 thành viên đã vào phòng"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnViewMembers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem thành viên →"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tiêu đề phần Đề cử phim -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="Danh sách phim đề cử (3)"
                android:textColor="@color/cinenow_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Bình chọn để nhóm chọn ra bộ phim ưng ý nhất"
                android:textColor="@color/cinenow_text_tertiary"
                android:textSize="12sp" />

            <!-- PHIM 1: Dune: Hành Tinh Cát 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMovie1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinenow_primary"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/cinenow_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Poster phim -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="70dp"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/poster_hanh_tinh_cat_2"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Tên phim + Tag dẫn đầu -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Dune: Hành Tinh Cát 2"
                                    android:textColor="@color/cinenow_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_rounded_icon"
                                    android:backgroundTint="@color/cinenow_success_container"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="Dẫn đầu"
                                    android:textColor="@color/cinenow_on_success_container"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Khoa học viễn tưởng • 166 phút"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_auth_star"
                                    app:tint="@color/cinenow_warning" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="8.9 ★  |  Rạp IMAX 2D"
                                    android:textColor="@color/cinenow_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Nút bình chọn -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVoteMovie1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:minHeight="34dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="0dp"
                                android:text="Đã bình chọn ✓"
                                android:textColor="@color/cinenow_white"
                                android:textSize="12sp"
                                app:backgroundTint="@color/cinenow_primary"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tiến trình vote -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressMovie1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:progress="67"
                            app:indicatorColor="@color/cinenow_primary"
                            app:trackColor="@color/cinenow_outline"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:id="@+id/tvVotesMovie1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="2 phiếu (67%) • Bạn, Hải đã chọn"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PHIM 2: Mai -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMovie2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/cinenow_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Poster phim -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="70dp"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/poster_mai"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mai"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Tâm lý, Tình cảm • 131 phút"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_auth_star"
                                    app:tint="@color/cinenow_warning" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="8.2 ★  |  Rạp 2D Phụ đề"
                                    android:textColor="@color/cinenow_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Nút bình chọn -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVoteMovie2"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:minHeight="34dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="0dp"
                                android:text="Bình chọn"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="12sp"
                                app:cornerRadius="8dp"
                                app:strokeColor="@color/cinenow_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tiến trình vote -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressMovie2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:progress="33"
                            app:indicatorColor="@color/cinenow_primary"
                            app:trackColor="@color/cinenow_outline"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:id="@+id/tvVotesMovie2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="1 phiếu (33%) • Nguyên đã chọn"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PHIM 3: Gia Tài Của Ngoại -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMovie3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/cinenow_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Poster phim -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="70dp"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/poster_gia_tai_cua_ngoai"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gia Tài Của Ngoại"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Gia đình, Chính kịch • 125 phút"
                                android:textColor="@color/cinenow_text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_auth_star"
                                    app:tint="@color/cinenow_warning" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="8.5 ★  |  Rạp 2D Lồng tiếng"
                                    android:textColor="@color/cinenow_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Nút bình chọn -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVoteMovie3"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:minHeight="34dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="0dp"
                                android:text="Bình chọn"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="12sp"
                                app:cornerRadius="8dp"
                                app:strokeColor="@color/cinenow_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tiến trình vote -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressMovie3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:progress="0"
                            app:indicatorColor="@color/cinenow_primary"
                            app:trackColor="@color/cinenow_outline"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:id="@+id/tvVotesMovie3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 phiếu (0%)"
                            android:textColor="@color/cinenow_text_tertiary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thanh hành động cố định bên dưới (Bottom Bar) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/cinenow_white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- Nút chính: Chốt phim & Đặt vé (mở ConfirmVoteBottomSheet) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmVote"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Chốt phim &amp; Đặt vé"
                android:textColor="@color/cinenow_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cinenow_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_auth_arrow_forward"
                app:iconGravity="textEnd"
                app:iconTint="@color/cinenow_white" />

            <!-- Nút phụ: Xem danh sách thành viên (mở RoomMembersBottomSheet) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenMembers"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Danh sách thành viên (3/4 đã vào)"
                android:textColor="@color/cinenow_text_primary"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_group"
                app:iconTint="@color/cinenow_primary"
                app:strokeColor="@color/cinenow_outline" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>