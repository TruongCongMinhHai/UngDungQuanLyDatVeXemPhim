<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinenow_background"
    android:fillViewport="true"
    tools:context=".ui.profile.ChangePasswordFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="40dp">

        <!-- Top Bar: Nút Back + Logo CineNow + Tiêu đề + Avatar nhỏ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/cinenow_text_primary" />

            <!-- Logo CineNow -->
            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Logo CineNow"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cinenow_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CineNow"
                    android:textColor="@color/cinenow_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đổi mật khẩu"
                    android:textColor="@color/cinenow_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Avatar nhỏ góc phải -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgTopAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@color/cinenow_surface_container_low"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp"
                app:tint="@color/cinenow_text_secondary" />
        </LinearLayout>

        <!-- Form nhập mật khẩu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- 1. Mật khẩu hiện tại -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mật khẩu hiện tại"
                android:textColor="@color/cinenow_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/cinenow_surface_container_low"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="1dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cinenow_text_tertiary"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_auth_lock"
                app:startIconTint="@color/cinenow_text_tertiary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCurrentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập mật khẩu hiện tại"
                    android:inputType="textPassword"
                    android:paddingVertical="12dp"
                    android:textColor="@color/cinenow_text_primary"
                    android:textColorHint="@color/cinenow_text_tertiary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Mật khẩu mới -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mật khẩu mới"
                android:textColor="@color/cinenow_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/cinenow_surface_container_low"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="1dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cinenow_text_tertiary"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_auth_lock"
                app:startIconTint="@color/cinenow_text_tertiary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập mật khẩu mới"
                    android:inputType="textPassword"
                    android:paddingVertical="12dp"
                    android:textColor="@color/cinenow_text_primary"
                    android:textColorHint="@color/cinenow_text_tertiary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hộp lưu ý an toàn (Info Hint Box) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_info_hint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_auth_info"
                    app:tint="@color/cinenow_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Mật khẩu nên có ít nhất 8 ký tự, gồm chữ và số."
                    android:textColor="@color/cinenow_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 3. Xác nhận mật khẩu mới -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Xác nhận mật khẩu mới"
                android:textColor="@color/cinenow_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/cinenow_surface_container_low"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="1dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cinenow_text_tertiary"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_auth_shield_check"
                app:startIconTint="@color/cinenow_text_tertiary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập lại mật khẩu mới"
                    android:inputType="textPassword"
                    android:paddingVertical="12dp"
                    android:textColor="@color/cinenow_text_primary"
                    android:textColorHint="@color/cinenow_text_tertiary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Nút Cập nhật mật khẩu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdatePassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:text="Cập nhật mật khẩu"
            android:textColor="@color/cinenow_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cinenow_primary"
            app:cornerRadius="14dp"
            app:rippleColor="@color/cinenow_primary_container" />

        <!-- Nút Hủy -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelChange"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="Hủy"
            android:textColor="@color/cinenow_text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:rippleColor="@color/cinenow_surface_container" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>