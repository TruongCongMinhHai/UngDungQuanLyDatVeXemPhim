<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng "lý do gợi ý" trong thẻ Top 1 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/bg_auth_oval"
        android:backgroundTint="@color/cinenow_on_success_container"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:src="@drawable/ic_cm_check"
        app:tint="@color/cinenow_white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvReasonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cinenow_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReasonDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cinenow_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>