<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <!-- Header chung CineNow -->
    <com.ute.cinenow.utils.CineHeader
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:headerShowBack="true"
        app:headerTitle="Lời Mời Kết Bạn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- 2 tab: Da nhan (2) / Da gui (1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="#F1F5F9"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/tabReceived"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="@android:color/white"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTabReceivedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã nhận"
                        android:textColor="#4F46E5"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReceivedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#5B3DF5"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="1dp"
                        android:text="2"
                        android:textColor="@android:color/white"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabSent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTabSentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã gửi"
                        android:textColor="#475569"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvSentBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#E2E8F0"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="1dp"
                        android:text="1"
                        android:textColor="#475569"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Banner mo ta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="#F4F2FF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="#EDE9FE"
                    android:contentDescription="Tìm bạn đồng hành"
                    android:padding="7dp"
                    android:src="@drawable/ic_home_people"
                    app:tint="#5B3DF5" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Tìm bạn đồng hành đi rạp cùng sở thích. Độ tương thích dựa trên lịch sử đặt vé và đánh giá thực tế."
                    android:textColor="#475569"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- CONTAINER TAB DA NHAN -->
            <LinearLayout
                android:id="@+id/layoutReceivedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Loi moi 1: Nguyen Thao Ly -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRequest1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <!-- Avatar bo tron co cham xanh vien trang -->
                            <FrameLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:cardBackgroundColor="#E2E8F0"
                                    app:cardCornerRadius="25dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="Nguyễn Thảo Ly"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_person"
                                        app:tint="#64748B" />
                                </androidx.cardview.widget.CardView>

                                <FrameLayout
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="bottom|end"
                                    android:background="@drawable/bg_camera_circle"
                                    android:backgroundTint="@android:color/white"
                                    android:padding="2dp">

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/bg_camera_circle"
                                        android:backgroundTint="#10B981" />
                                </FrameLayout>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Nguyễn Thảo Ly"
                                    android:textColor="#0F172A"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="22 tuổi"
                                    android:textColor="#64748B"
                                    android:textSize="11.5sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:contentDescription="Rạp chiếu"
                                        android:src="@drawable/ic_home_place"
                                        app:tint="#64748B" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="3dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="Hay đi: CineNow Landmark 81"
                                        android:textColor="#64748B"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Badge Khop gu co icon -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#EEF2FF"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="Khớp gu"
                                    android:src="@drawable/ic_md_star"
                                    app:tint="#5B3DF5" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="92% Khớp gu"
                                    android:textColor="#5B3DF5"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Khung loi nhan chu nghieng -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#F8FAFC"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginTop="2dp"
                                android:contentDescription="Lời nhắn"
                                android:src="@drawable/ic_info"
                                app:tint="#94A3B8" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:lineSpacingExtra="2dp"
                                android:text="&quot;Chào bạn, mình thấy bạn cũng hay xem IMAX ở Landmark 81, kết bạn để rủ nhau xem phim nhé!&quot;"
                                android:textColor="#334155"
                                android:textSize="11.5sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <!-- So thich chung -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Sở thích chung:"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F8FAFC"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="Sci-Fi"
                                    android:src="@drawable/ic_md_star"
                                    app:tint="#5B3DF5" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Sci-Fi"
                                    android:textColor="#1E293B"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F8FAFC"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="Anime"
                                    android:src="@drawable/ic_ticket"
                                    app:tint="#7E22CE" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Anime"
                                    android:textColor="#1E293B"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F8FAFC"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="IMAX"
                                    android:src="@drawable/ic_ticket"
                                    app:tint="#4F46E5" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Định dạng IMAX Laser"
                                    android:textColor="#1E293B"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Nut Tu choi / Chap nhan -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDecline1"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F1F5F9"
                                android:text="✕  Từ chối"
                                android:textAllCaps="false"
                                android:textColor="#334155"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAccept1"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#5B3DF5"
                                android:text="Chấp nhận"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_home_people"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="16dp"
                                app:iconTint="@android:color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Loi moi 2: Dang Tuan Kiet -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRequest2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:cardBackgroundColor="#E2E8F0"
                                    app:cardCornerRadius="25dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="Đặng Tuấn Kiệt"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_person"
                                        app:tint="#64748B" />
                                </androidx.cardview.widget.CardView>

                                <FrameLayout
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="bottom|end"
                                    android:background="@drawable/bg_camera_circle"
                                    android:backgroundTint="@android:color/white"
                                    android:padding="2dp">

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/bg_camera_circle"
                                        android:backgroundTint="#10B981" />
                                </FrameLayout>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Đặng Tuấn Kiệt"
                                    android:textColor="#0F172A"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="26 tuổi"
                                    android:textColor="#64748B"
                                    android:textSize="11.5sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:contentDescription="Cụm rạp"
                                        android:src="@drawable/ic_home_place"
                                        app:tint="#64748B" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="3dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="Cụm rạp: CineNow Bitexco"
                                        android:textColor="#64748B"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#EEF2FF"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="Khớp gu"
                                    android:src="@drawable/ic_md_star"
                                    app:tint="#5B3DF5" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="88% Khớp gu"
                                    android:textColor="#5B3DF5"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Sở thích chung:"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F8FAFC"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="Hành động"
                                    android:src="@drawable/ic_md_star"
                                    app:tint="#5B3DF5" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Hành động"
                                    android:textColor="#1E293B"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_icon"
                                android:backgroundTint="#F8FAFC"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="Marvel &amp; DC"
                                    android:src="@drawable/ic_ticket"
                                    app:tint="#4F46E5" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Marvel &amp; DC"
                                    android:textColor="#1E293B"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#F8FAFC"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="5dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="Ghế Đôi Sweetbox"
                                android:src="@drawable/ic_home_people"
                                app:tint="#10B981" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Ghế Đôi Sweetbox"
                                android:textColor="#1E293B"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDecline2"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F1F5F9"
                                android:text="✕  Từ chối"
                                android:textAllCaps="false"
                                android:textColor="#334155"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAccept2"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#5B3DF5"
                                android:text="Chấp nhận"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_home_people"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="16dp"
                                app:iconTint="@android:color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- CONTAINER TAB DA GUI -->
            <LinearLayout
                android:id="@+id/layoutSentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSentRequest1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:cardBackgroundColor="#E2E8F0"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Phạm Thảo Vy"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_person"
                                    app:tint="#64748B" />
                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Phạm Thảo Vy"
                                    android:textColor="#0F172A"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Đã gửi 2 giờ trước • 95% Khớp gu"
                                    android:textColor="#64748B"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelSent1"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#F1F5F9"
                            android:text="Hủy lời mời đã gửi"
                            android:textAllCaps="false"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Ghi chu cuoi trang co icon ben trai -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="Thông tin hết hạn"
                    android:src="@drawable/ic_info"
                    app:tint="#64748B" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Lời mời kết bạn tự động hết hạn sau 14 ngày nếu không được chấp nhận."
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>