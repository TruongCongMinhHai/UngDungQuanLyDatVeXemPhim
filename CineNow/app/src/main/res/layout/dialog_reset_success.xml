<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp ngoài FrameLayout tạo lề 20dp hai bên (lề của gốc dialog không có tác dụng) -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/cinenow_surface_container_lowest"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="40dp">

            <!-- Icon dấu tích + chấm nhỏ -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp">

                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:alpha="0.2"
                    android:background="@drawable/bg_auth_oval"
                    android:backgroundTint="@color/cinenow_success" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_auth_oval"
                    android:backgroundTint="@color/cinenow_success"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_auth_check_white" />

                <FrameLayout
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_auth_oval"
                    android:backgroundTint="@color/cinenow_success">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_auth_oval"
                        android:backgroundTint="@color/cinenow_on_success_container" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Đặt lại mật khẩu thành công!"
                android:textAlignment="center"
                android:textColor="@color/cinenow_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bạn có thể sử dụng mật khẩu mới để đăng nhập vào tài khoản CineNow ngay bây giờ."
                android:textAlignment="center"
                android:textColor="@color/cinenow_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/cinenow_primary"
                android:text="Quay lại đăng nhập"
                android:textAllCaps="false"
                android:textColor="@color/cinenow_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_auth_login"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/cinenow_on_primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>