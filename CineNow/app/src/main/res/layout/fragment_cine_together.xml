<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cinenow_background"
    tools:context=".ui.cinetogether.CineTogetherFragment">

    <!-- Header dùng chung CineHeader: cố định 64dp, có nút back, có nút profile -->
    <com.ute.cinenow.utils.CineHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Đi cùng nhóm"
        app:headerShowBack="true"
        app:headerShowProfile="true" />

    <!-- Vùng nội dung cuộn bên dưới Header -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <!-- 1. Hero Banner: Giới thiệu CineTogether -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cinenow_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@color/cinenow_secondary_container"
                            android:padding="10dp"
                            android:src="@drawable/ic_group"
                            app:tint="@color/cinenow_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CineTogether"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Xem phim cùng hội bạn"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Tạo phòng, mời bạn bè cùng bình chọn phim theo số đông và tự động chia đều tiền vé qua ví điện tử."
                        android:textColor="@color/cinenow_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Hai nút hành động nhanh: Tạo phòng & Tham gia phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Nút 1: Tạo phòng mới (#20) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCreateRoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/cinenow_primary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#33FFFFFF"
                            android:padding="6dp"
                            android:src="@drawable/ic_group"
                            app:tint="@color/cinenow_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Tạo phòng mới"
                            android:textColor="@color/cinenow_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Làm trưởng nhóm (#20)"
                            android:textColor="#D6D1E7"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nút 2: Tham gia phòng (#21) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/cinenow_white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/cinenow_primary"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@color/cinenow_secondary_container"
                            android:padding="6dp"
                            android:src="@drawable/ic_auth_lock"
                            app:tint="@color/cinenow_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Nhập mã PIN"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tham gia phòng (#21)"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 3. Tiêu đề mục Phòng đang hoạt động -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp"
                android:text="PHÒNG BÌNH CHỌN ĐANG MỞ (1)"
                android:textColor="@color/cinenow_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Card Phòng đang hoạt động (#22) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cinenow_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/cinenow_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Trạng thái & Mã PIN phòng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Badge Đang mở bình chọn -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#DCFCE7"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_camera_circle"
                                android:backgroundTint="#16A34A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Đang bình chọn"
                                android:textColor="#16A34A"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Mã PIN phòng -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@color/cinenow_surface_container_low"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Mã: #CT-8821"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tên phòng & Địa điểm đề xuất -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="UIT Movie Weekend"
                        android:textColor="@color/cinenow_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Rạp đề xuất: CGV Landmark 81 • 4 thành viên"
                        android:textColor="@color/cinenow_text_secondary"
                        android:textSize="12sp" />

                    <!-- Phim dẫn đầu bình chọn -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_info_hint"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="32dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/poster_hanh_tinh_cat_2"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phim dẫn đầu: Hành Tinh Cát 2"
                                android:textColor="@color/cinenow_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="3/4 bạn đã bình chọn (75% đồng thuận)"
                                android:textColor="@color/cinenow_primary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/cinenow_primary" />
                    </LinearLayout>

                    <!-- Nút Vào phòng bình chọn ngay -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnterActiveRoom"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:text="Vào phòng bình chọn ngay"
                        android:textColor="@color/cinenow_white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/cinenow_primary"
                        app:cornerRadius="12dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_auth_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconPadding="8dp"
                        app:iconTint="@color/cinenow_white" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Tiêu đề mục Cách thức hoạt động -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp"
                android:text="3 BƯỚC XEM PHIM CÙNG NHÓM"
                android:textColor="@color/cinenow_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Card 3 bước hướng dẫn -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cinenow_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Bước 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="@color/cinenow_secondary_container"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Tạo phòng và chia sẻ mã PIN 6 số cho nhóm"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:layout_marginStart="38dp"
                        android:background="@color/cinenow_outline" />

                    <!-- Bước 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="@color/cinenow_secondary_container"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Cùng bình chọn danh sách phim và khung giờ rảnh"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:layout_marginStart="38dp"
                        android:background="@color/cinenow_outline" />

                    <!-- Bước 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="@color/cinenow_secondary_container"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Chốt phim có lượt vote cao nhất &amp; chia tiền vé tự động"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Tiêu đề mục Buổi xem gần đây -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp"
                android:text="BUỔI XEM GẦN ĐÂY"
                android:textColor="@color/cinenow_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Card Buổi xem đã chốt: Mai -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/cinenow_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/cinenow_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="50dp"
                        android:layout_height="68dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/poster_mai"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhóm KTX Khu B • 5 bạn"
                            android:textColor="@color/cinenow_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Phim đã xem: Mai (Đã chốt vé)"
                            android:textColor="@color/cinenow_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Xem lại kết quả bình chọn (#30)"
                            android:textColor="@color/cinenow_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/cinenow_text_tertiary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>