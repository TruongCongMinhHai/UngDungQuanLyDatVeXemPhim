<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1A1A1A" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_rounded_icon"
            android:backgroundTint="#F3F0FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cinenow_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CineNow"
                    android:textColor="#5850EC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hồ sơ người dùng"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_camera_circle"
            android:backgroundTint="#5850EC"
            android:padding="6dp"
            android:src="@drawable/ic_person"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Avatar & Name Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_camera_circle"
                        android:backgroundTint="#CBD5E1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Trần Bảo Long"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="\@baolong_cinema"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <!-- Badge Thành viên thân thiết -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="#F3F0FF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Thành viên thân thiết • 24 vé đã xem"
                        android:textColor="#5850EC"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🔒 Thông tin liên lạc cá nhân được bảo vệ an toàn"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Compatibility Card (Chỉ số tương thích điện ảnh) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#5850EC"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✨ Chỉ số tương thích điện ảnh"
                            android:textColor="@android:color/white"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#4338CA"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="⚙️ Thuật toán khớp gu"
                            android:textColor="@android:color/white"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="96%"
                        android:textColor="@android:color/white"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Độ khớp gu điện ảnh"
                        android:textColor="#E0E7FF"
                        android:textSize="11.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#4338CA"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView android:text="Thể loại" android:textColor="#E0E7FF" android:textSize="10.5sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="98%" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#4338CA"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView android:text="Định dạng" android:textColor="#E0E7FF" android:textSize="10.5sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="94%" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#4338CA"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView android:text="Khung giờ" android:textColor="#E0E7FF" android:textSize="10.5sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="92%" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Điểm chung của hai bạn Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👥 Điểm chung của hai bạn"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 điểm chung lớn"
                    android:textColor="#5850EC"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Common Point 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView android:text="THỂ LOẠI PHIM ƯA CHUỘNG" android:textColor="#64748B" android:textSize="10.5sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Khoa học viễn tưởng (IMAX), Tâm lý giật gân" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <LinearLayout android:orientation="horizontal" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="Sci-Fi Epic" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:textColor="#475569" android:textSize="10sp" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Psychological Thriller" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#F1F5F9" android:textColor="#475569" android:textSize="10sp" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Common Point 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView android:text="CỤM RẠP THƯỜNG GHÉ NHẤT" android:textColor="#64748B" android:textSize="10.5sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="CineNow Landmark 81" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Khoảng cách trung bình thuận tiện cho cả hai" android:textColor="#64748B" android:textSize="11.5sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Common Point 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView android:text="KHUNG GIỜ VÀNG ĐI XEM CHUNG" android:textColor="#64748B" android:textSize="10.5sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Tối Thứ 7 &amp; Chủ Nhật (Sau 19:30)" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="✅ Lịch rảnh trùng khớp hoàn hảo tuần này" android:textColor="#10B981" android:textSize="11.5sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Phim tâm đắc nhất Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="❤️ Phim tâm đắc nhất"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã xếp hạng 5 sao"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Horizontal Scroll Movies -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Movie Item 1 -->
                    <LinearLayout android:orientation="vertical" android:layout_width="110dp" android:layout_marginEnd="10dp" android:layout_height="wrap_content">
                        <ImageView android:layout_width="match_parent" android:layout_height="150dp" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:scaleType="centerCrop"/>
                        <TextView android:text="Hành Tinh Cát 2" android:textColor="#0F172A" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:text="Denis Villeneuve" android:textColor="#64748B" android:textSize="10.5sp" android:maxLines="1" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Movie Item 2 -->
                    <LinearLayout android:orientation="vertical" android:layout_width="110dp" android:layout_marginEnd="10dp" android:layout_height="wrap_content">
                        <ImageView android:layout_width="match_parent" android:layout_height="150dp" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:scaleType="centerCrop"/>
                        <TextView android:text="Oppenheimer" android:textColor="#0F172A" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:text="Christopher Nolan" android:textColor="#64748B" android:textSize="10.5sp" android:maxLines="1" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Movie Item 3 -->
                    <LinearLayout android:orientation="vertical" android:layout_width="110dp" android:layout_height="wrap_content">
                        <ImageView android:layout_width="match_parent" android:layout_height="150dp" android:background="@drawable/bg_rounded_icon" android:backgroundTint="#CBD5E1" android:scaleType="centerCrop"/>
                        <TextView android:text="Inception" android:textColor="#0F172A" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:text="Kẻ Trộm Giấc Mơ" android:textColor="#64748B" android:textSize="10.5sp" android:maxLines="1" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Community Note Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="#EEF2FF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_cinenow_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cộng đồng điện ảnh văn minh"
                        android:textColor="#312E81"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Bảo Long cam kết không spoil nội dung phim và đúng giờ khi xem chung."
                        android:textColor="#4338CA"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Connect Button -->
            <Button
                android:id="@+id/btnAddFriend"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#5850EC"
                android:text="👤+ Gửi lời mời kết bạn"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="🔒 Chỉ có thể trò chuyện và rủ xem phim sau khi cả hai đồng ý kết bạn."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>