<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1A1A1A" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_rounded_icon"
            android:backgroundTint="#F3F0FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cinenow_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CineNow"
                    android:textColor="#5850EC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn chỗ ngồi phù hợp"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_camera_circle"
            android:backgroundTint="#5850EC"
            android:padding="6dp"
            android:src="@drawable/ic_person"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD 1: Bạn đi xem cùng mấy người? -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bạn đi xem cùng mấy người?"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPeopleBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#EDE9FE"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="1 người"
                            android:textColor="#5850EC"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hệ thống sẽ tìm ghế ngồi cạnh nhau"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <!-- Stepper Box (- 1 người +) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#F8FAFC"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:id="@+id/btnMinus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@android:color/white"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvPeopleCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1"
                                    android:textColor="#312E81"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="người"
                                    android:textColor="#312E81"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ghế liền nhau"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnPlus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#5850EC"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@android:color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD 2: Bạn thích ngồi ở đâu? -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bạn thích ngồi ở đâu?"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Chọn 1 khu vực bạn cảm thấy thoải mái nhất"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <!-- Option 1: Khu vực trung tâm -->
                    <LinearLayout
                        android:id="@+id/optCenter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#F8FAFC"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:id="@+id/dotOptCenter"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="#E2E8F0" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOptCenterTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Khu vực trung tâm"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vị trí cân đối, dễ xem phim"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mặc định"
                            android:textColor="#5850EC"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Option 2: Gần màn hình -->
                    <LinearLayout
                        android:id="@+id/optFront"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#F8FAFC"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:id="@+id/dotOptFront"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="#E2E8F0" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOptFrontTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gần màn hình"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ngồi gần màn chiếu hơn"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Option 3: Hàng ghế phía sau -->
                    <LinearLayout
                        android:id="@+id/optBack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#F8FAFC"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:id="@+id/dotOptBack"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="#E2E8F0" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOptBackTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hàng ghế phía sau"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ngồi xa màn hình hơn"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Option 4: Ghế đôi -->
                    <LinearLayout
                        android:id="@+id/optCouple"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#F8FAFC"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:id="@+id/dotOptCouple"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_camera_circle"
                            android:backgroundTint="#E2E8F0" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOptCoupleTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghế đôi"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phù hợp khi đi cùng người thân hoặc bạn bè"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD 3: Ưu tiên thêm -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ưu tiên thêm"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tùy chọn phụ giúp lọc vị trí ưng ý nhất"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <!-- Extra 1: Tránh ghế sát góc -->
                    <LinearLayout
                        android:id="@+id/extraAvoidCorner"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#F8FAFC"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@android:color/white"
                            android:padding="6dp"
                            android:src="@drawable/ic_explore"
                            app:tint="#312E81" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Tránh ghế sát góc"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/checkAvoidCorner"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#CBD5E1" />
                    </LinearLayout>

                    <!-- Extra 2: Tránh hàng ghế quá gần màn hình -->
                    <LinearLayout
                        android:id="@+id/extraAvoidFrontRow"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_icon"
                        android:backgroundTint="#F8FAFC"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="@android:color/white"
                            android:padding="6dp"
                            android:src="@drawable/ic_info"
                            app:tint="#312E81" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Tránh hàng ghế quá gần màn hình"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/checkAvoidFrontRow"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_rounded_icon"
                            android:backgroundTint="#CBD5E1" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Buttons Section -->
            <Button
                android:id="@+id/btnFindSeats"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#5850EC"
                android:text="🔍  Tìm ghế phù hợp"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnManualSelect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@android:color/white"
                android:text="Tự chọn ghế trên sơ đồ"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Nếu không đủ ghế liền kề theo sở thích, bạn vẫn có thể tự\nchọn trực tiếp trên sơ đồ ghế."
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>