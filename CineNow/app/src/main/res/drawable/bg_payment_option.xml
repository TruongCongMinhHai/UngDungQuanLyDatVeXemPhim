<?xml version="1.0" encoding="utf-8"?>
<!-- Nền thẻ phương thức thanh toán: đang chọn (isSelected = true) có nền tím nhạt + viền tím -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#EEF2FF" />
            <stroke android:width="1.5dp" android:color="#5850EC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#F8FAFC" />
            <stroke android:width="1dp" android:color="#E2E8F0" />
        </shape>
    </item>
</selector>
