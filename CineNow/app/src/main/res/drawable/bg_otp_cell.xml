<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Ô đang nhập -->
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/cinenow_secondary_container" />
      <stroke android:width="2dp" android:color="@color/cinenow_primary" />
      <corners android:radius="12dp" />
    </shape>
  </item>
  <!-- Ô thường -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/cinenow_surface_container_lowest" />
      <stroke android:width="1dp" android:color="@color/cinenow_outline" />
      <corners android:radius="12dp" />
    </shape>
  </item>
</selector>